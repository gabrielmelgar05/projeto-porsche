{
  "name": "porsche-gt3rs-experience",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "node scripts/serve-static.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "images:list": "node scripts/record-image-dimensions.mjs && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/list-images.mts",
    "images": "npm run images:list && node scripts/optimize-images.mjs",
    "images:audit": "node scripts/audit-images.mjs",
    "brand": "node scripts/generate-mark.mjs && node scripts/build-social.mjs && node scripts/prepare-crest.mjs",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run build && npm run test:e2e",
    "format": "prettier --write src tests scripts \"*.{ts,mjs,json,md}\""
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "gsap": "^3.15.1",
    "lucide-react": "^1.72.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.10.1",
    "sharp": "^0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.18"
  }
}
